# Server
PORT=4173
APP_BASE_URL=http://localhost:4173
SESSION_SECRET=change-this-long-random-value
SESSION_MAX_AGE_SECONDS=7776000
SESSION_TOUCH_INTERVAL_MS=43200000

# Google OAuth - fill these in from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/auth/callback

# Instagram OAuth scaffold - requires a Meta app and approved publishing permissions
INSTAGRAM_CLIENT_ID=1799865634309648
INSTAGRAM_CLIENT_SECRET=b17b1098c64391590fde504f790c41f5
INSTAGRAM_REDIRECT_URI=http://localhost:4173/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com/v24.0
INSTAGRAM_PROCESSING_ATTEMPTS=30
INSTAGRAM_PROCESSING_DELAY_MS=10000

# AI metadata generation - keep this secret on the server
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# YouTube upload defaults: private, unlisted, or public
YOUTUBE_PRIVACY_STATUS=public

# Tool paths - keep defaults on Render Docker
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
YTDLP_JS_RUNTIME=node:/usr/local/bin/node
YTDLP_COOKIES_PATH=./cookies.txt
# Optional backups. Separate multiple files with commas or semicolons.
YTDLP_COOKIES_PATHS=./cookies.txt
YTDLP_VERBOSE=false

# Fast Shorts processing defaults
SHORT_START=00:01:00
SHORT_DURATION=45
SHORT_WIDTH=1080
SHORT_HEIGHT=1920
YTDLP_FORMAT=bv*[height>=1080][height<=2160]+ba/b[height>=1080][height<=2160]/bv*[height<=1080]+ba/b[height<=1080]/best
YTDLP_FORMAT_SORT=res:2160,fps,ext:mp4:m4a
FFMPEG_PRESET=medium
FFMPEG_CRF=16
FFMPEG_MAXRATE=24M
FFMPEG_BUFSIZE=48M
AUDIO_BITRATE=320k
YTDLP_MAX_HEIGHT=2160
TRANSCRIPT_LANGS=en.*,en
RENDER_TIMEOUT_MS=1800000
MIN_RENDER_TIMEOUT_MS=1200000
UPLOAD_CHUNK_SIZE=8388608
UPLOAD_TIMEOUT_MS=600000
MAX_SOURCE_DURATION_SECONDS=7200
